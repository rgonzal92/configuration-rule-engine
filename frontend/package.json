{
  "name": "configuration-rule-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --define \"PRIMEUI_LICENSE_KEY='${PRIMEUI_LICENSE_KEY:-}'\"",
    "test": "ng test --watch=false",
    "lint": "oxlint --deny-warnings src",
    "format": "oxfmt --write src angular.json package.json tsconfig*.json",
    "format:check": "oxfmt --check src angular.json package.json tsconfig*.json"
  },
  "dependencies": {
    "@angular/cdk": "22.1.6",
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/forms": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/router": "22.1.6",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@primeuix/themes": "3.0.1",
    "primeicons": "8.0.2",
    "primeng": "22.1.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.6",
    "@tailwindcss/postcss": "4.3.3",
    "jsdom": "28.0.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tailwindcss-primeui": "0.6.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
