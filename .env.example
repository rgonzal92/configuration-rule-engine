CRE_DB_PASSWORD=replace-with-a-local-password
CRE_HTTP_PORT=8080
# Optional: enables the live AI assistant. Without a key, the example parser answers.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
# Optional: the PrimeUI license key, built into the frontend. Without it the page shows a small
# "Invalid PrimeUI License" notice.
# PRIMEUI_LICENSE_KEY=
# Public deployment only: start the cre-proxy Caddy service with the app.
# COMPOSE_PROFILES=public
# The existing Docker network where the Cloudflare Tunnel's reverse proxy runs.
# CRE_INGRESS_NETWORK=
# The loopback port where cre-proxy answers, for checks on this machine.
# CRE_PROXY_PORT=8081
