{
	# No admin API; the config changes only when the container restarts.
	admin off
}

:8080 {
	request_body {
		max_size 64KiB
	}

	# CRE_UPSTREAM exists only so the proxy test can point Caddy at a stub.
	reverse_proxy {$CRE_UPSTREAM:app:8080} {
		# The app trusts no forwarded headers, so none are passed on.
		header_up -Forwarded
		header_up -X-Forwarded-*
		header_up -Cf-Connecting-Ip
	}
}
